                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tasks/REPLACE_WITH_TASK_ID",
              "host": [
                "{{base_url}}"
              ],
